<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mic access for dictation -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Downloading the ASR model on first run -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service that runs the (large, ~650MB) model download with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ClinicalScribeApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ClinicalScribe"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClinicalScribe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent trampoline used to request RECORD_AUDIO / POST_NOTIFICATIONS from
             inside the keyboard's restricted process, which cannot show a permission
             dialog itself. It starts, asks, and finishes immediately. -->
        <activity
            android:name=".PermissionTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.ClinicalScribe.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- The custom keyboard (Input Method Editor). Only the system may bind to it. -->
        <service
            android:name=".ime.DictationInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Foreground service that downloads and unpacks the on-device ASR model. -->
        <service
            android:name=".download.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
