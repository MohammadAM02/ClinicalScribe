<?xml version="1.0" encoding="utf-8"?>
<!-- Declares this as an Input Method with a single subtype. No subtype-specific
     language is declared since dictation language currently follows the bundled
     model (English); add more <subtype> entries here if you add more models. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android">
    <subtype
        android:label="@string/ime_subtype_label"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="voice" />
</input-method>
